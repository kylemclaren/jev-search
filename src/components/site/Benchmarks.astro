---
import bench from "../../../bench/results.json"

interface KindAgg { hit1: number; hit3: number; mrr: number; n: number }
interface SystemResult {
  name: string
  version: string
  kind: string
  latencyMs: { median: number; p95: number }
  hit1: number
  hit3: number
  mrr: number
  byKind: Record<string, KindAgg>
  perQuery: { query: string; kind: string; rank: number | null; top: string[] }[]
}

const systems = (bench.systems as SystemResult[]).slice().sort((a, b) => b.hit1 - a.hit1 || b.mrr - a.mrr)
const ours = systems.find((s) => s.name === "jev-search")!
const rivals = systems.filter((s) => !s.name.startsWith("jev-search"))

// Queries where only jev-search puts the right page first.
const wins = ours.perQuery
  .filter((q) => q.kind !== "keyword" && q.rank === 1)
  .filter((q) => rivals.every((r) => (r.perQuery.find((x) => x.query === q.query)?.rank ?? 99) > 1))
  .slice(0, 6)

const pct = (x: number) => `${Math.round(x * 100)}%`
const ms = (x: number) => (x < 10 ? x.toFixed(2) : Math.round(x).toString())
const generated = new Date(bench.generatedAt).toISOString().slice(0, 10)
const corpus = bench.corpus as { documents: number; pages: number; source: string }
// How often a library returns nothing at all for a query.
const blanks = (s: SystemResult) => s.perQuery.filter((q) => q.top.length === 0).length
const pagefind = systems.find((s) => s.name === "Pagefind")
---

<div class="quality-card">
  <div class="quality-heading">
    <strong>every library, same corpus, same queries</strong>
    <span>hit@3 by query type · latency per query</span>
  </div>
  <div class="quality-scroll">
    <table>
      <thead>
        <tr>
          <th>library</th>
          <th>hit@1</th>
          <th>hit@3</th>
          <th>mrr</th>
          <th>keyword</th>
          <th>typos</th>
          <th>intent</th>
          <th>median</th>
          <th>p95</th>
        </tr>
      </thead>
      <tbody>
        {
          systems.map((s) => (
            <tr class={s.name === "jev-search" ? "ours" : ""}>
              <td>
                {s.name.replace("jev-search (lexical only)", "jev-search · lexical")} <small>{s.version}</small>
              </td>
              <td>{pct(s.hit1)}</td>
              <td>{pct(s.hit3)}</td>
              <td>{s.mrr.toFixed(2)}</td>
              <td>{pct(s.byKind.keyword.hit3)}</td>
              <td>{pct(s.byKind.typo.hit3)}</td>
              <td>{pct(s.byKind.intent.hit3)}</td>
              <td>{ms(s.latencyMs.median)} ms</td>
              <td>{ms(s.latencyMs.p95)} ms</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p>
    {bench.queries.total} labelled queries over all {corpus.pages} TypeSafe doc pages, split at headings into{" "}
    {corpus.documents} documents. Same corpus for every library; Pagefind gets real HTML so its heading weighting
    applies. jev-search includes the network round trip with the cache off. {generated}, <code>bun run bench</code>.
  </p>
</div>

{
  pagefind && (
    <p class="fine" style="margin-top:14px">
      Pagefind requires every query term to appear, so it returns nothing at all for {blanks(pagefind)} of the{" "}
      {bench.queries.total} queries.
    </p>
  )
}

{
  wins.length > 0 && (
    <>
      <p class="fine" style="margin-top:18px">Queries only jev-search gets first:</p>
      <ul class="win-list">
        {wins.map((w) => (
          <li>
            <span>“{w.query}”</span>
            <code>{w.top[0]}</code>
          </li>
        ))}
      </ul>
    </>
  )
}
