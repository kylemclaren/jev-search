---
import Layout from "@/layouts/main.astro"
import Mark from "@/mark.svg"
import Tabs from "@/components/docs/Tabs.astro"
import Benchmarks from "@/components/site/Benchmarks.astro"
import HeroSearch from "@/components/site/HeroSearch"
import { Code } from "astro:components"
import bench from "../../bench/results.json"

const repo = "https://github.com/kylemclaren/jev-search"
const add = "npx shadcn@latest add https://jev-search.fly.dev/r/jev-search.json"

const corpus = bench.corpus as { documents: number; pages: number; source: string }
const systems = bench.systems as {
  name: string
  hit1: number
  byKind: Record<string, { hit1: number }>
  latencyMs: { median: number }
}[]
const ours = systems.find((s) => s.name === "jev-search")!
const best = systems
  .filter((s) => !s.name.startsWith("jev-search"))
  .slice()
  .sort((a, b) => b.byKind.intent.hit1 - a.byKind.intent.hit1)[0]
const pct = (x: number) => `${Math.round(x * 100)}%`
// Cost, measured by the benchmark rather than guessed.
const cost = bench.cost as { meanInputTokens: number; usdPerMillionInputTokens: number }
const ceiling = bench.candidateRecall as { candidates: number; recall: number }
const perThousand = (1000 * (cost.meanInputTokens / 1e6) * cost.usdPerMillionInputTokens).toFixed(2)

const usage = `import { JevSearch } from "@/components/jev-search"

export function Nav() {
  return (
    <JevSearch
      placeholder="Search docs…"
      suggestions={["how do I deploy", "what does it cost"]}
    />
  )
}`

// A real exchange, trimmed to three of the twenty candidates. Values verbatim.
const wireRequest = `POST https://api.typesafe.ai/v1/systemone

{
  "model": "jev-latest",
  "state": {
    "query": "what do I do when I get a 429",
    "candidates": [
      { "id": "c1",  "section": "Primitives",
        "title": "When to structure a question",
        "excerpt": "When it helps with clarity. When a question has multiple parts\u2026" },
      { "id": "c10", "section": "SDKs",
        "title": "Retries",
        "excerpt": "Configure retries with RetryPolicy \u2014 attempt count, retryable statuses\u2026" },
      { "id": "c11", "section": "API",
        "title": "Errors",
        "excerpt": "Errors use standard HTTP status codes with a JSON body\u2026" }
    ]
  },
  "questions": {
    "c1": {
      "type": "noul",
      "instructions": "The user typed the search query above into a site search box.
                       Is candidate c1 (\\"When to structure a question\\") a page they
                       would be glad to land on for that query?",
      "criteria": {
        "true":  "The page answers, covers or is clearly about what the query is asking for",
        "false": "The page is off-topic, or only shares a word or two with the query"
      }
    },
    "best": {
      "type": "choice",
      "instructions": "Which candidate page best answers the user's search query?",
      "criteria": { "c1": "When to structure a question", "c10": "Retries", "c11": "Errors" }
    },
    "answerable": {
      "type": "noul",
      "instructions": "Does at least one candidate page answer the user's search query?"
    }
  }
}`

const wireAnswer = `{
  "model": "jev-1.13.0",
  "answers": {
    "c1":  { "type": "noul", "noul": 0.03 },
    "c2":  { "type": "noul", "noul": 0.02 },
    "c3":  { "type": "noul", "noul": 0.06 },
    "c10": { "type": "noul", "noul": 0.86 },
    "c11": { "type": "noul", "noul": 0.60 },
    "best": {
      "type": "choice",
      "choice": "c10",
      "confidence": 0.9,
      "probabilities": { "c10": 0.91, "c11": 0.09 }
    },
    "answerable": { "type": "noul", "noul": 0.72 }
  },
  "usage": { "input_tokens": 6264, "output_tokens": 560 }
}`

const docShape = `{
  "id": "pricing",
  "title": "Pricing",
  "url": "/docs/pricing",
  "description": "What it costs and how to cap it.",
  "section": "Company",
  "content": "Usage is billed per request…",
  "keywords": ["billing", "cost"]
}`
---

<Layout>
  <main class="page">
    <header class="mast">
      <a class="brand" href="./"><Mark /> jev-search</a>
      <div class="mast-right">
        <a class="repo-link" href="#benchmarks">benchmarks</a>
        <a class="repo-link" href="#install">install</a>
        <a class="repo-link" href="#how">how it works</a>
        <a class="repo-link" href={repo} target="_blank" rel="noopener" aria-label="GitHub repository (opens in a new tab)">
          <svg class="gh" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path></svg
          >
          GitHub
        </a>
      </div>
    </header>

    <section class="hero">
      <h1>Site search, <mark>re-ranked by a model.</mark></h1>
      <p class="lede">
        A keyword pass answers on the first keystroke, then
        <a href="https://typesafe.ai" target="_blank" rel="noopener">TypeSafe</a>'s Jev model re-ranks the top twenty by
        what the query meant. Searching all {corpus.pages} pages of the
        <a href="https://docs.typesafe.ai" target="_blank" rel="noopener">TypeSafe docs</a>, live:
      </p>

      <HeroSearch client:load />

      <div class="cmd hero-cmd">
        <code data-registry-line>{add}</code>
        <button class="copy small" type="button" data-copy-from-registry aria-label="Copy install command"
          ><span class="material-symbols-rounded" aria-hidden="true">content_copy</span></button
        >
      </div>

      <dl class="stat-strip">
        <div>
          <dt>hit@1, questions</dt>
          <dd>{pct(ours.byKind.intent.hit1)}</dd>
        </div>
        <div>
          <dt>best of the six ({best.name})</dt>
          <dd class="muted">{pct(best.byKind.intent.hit1)}</dd>
        </div>
        <div>
          <dt>re-rank, uncached</dt>
          <dd>{Math.round(ours.latencyMs.median)} ms</dd>
        </div>
        <div>
          <dt>per 1,000 searches</dt>
          <dd>${perThousand}</dd>
        </div>
      </dl>
    </section>

    <section class="machine" id="benchmarks" aria-labelledby="bench-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">benchmarks</p>
          <h2 id="bench-title">Results against six keyword libraries</h2>
        </div>
        <a class="repo-link" href={`${repo}/blob/main/bench/queries.json`} target="_blank" rel="noopener">query set ↗</a>
      </div>
      <Benchmarks />
    </section>

    <section class="machine" id="install" aria-labelledby="install-title">
      <div class="section-head">
        <div><p class="eyebrow">install</p><h2 id="install-title">Adding it to a project</h2></div>
        <a class="repo-link" href="/r/jev-search.json">registry json</a>
      </div>
      <div class="steps-grid">
        <div class="step-row">
          <span class="step-num">1</span>
          <div>
            <h3>Add the block</h3>
            <div class="cmd">
              <code data-registry-line>{add}</code>
              <button class="copy small" type="button" data-copy-from-registry aria-label="Copy install command"
                ><span class="material-symbols-rounded" aria-hidden="true">content_copy</span></button
              >
            </div>
            <p class="fine">
              Component, hook, keyword index, server handler and API route. Set <code>TYPESAFE_API_KEY</code>; it stays on
              the server.
            </p>
          </div>
        </div>
        <div class="step-row">
          <span class="step-num">2</span>
          <div>
            <h3>Feed it documents</h3>
            <Code code={docShape} lang="json" theme="github-light" />
            <p class="fine">
              Or point the bundled indexer at Markdown: <code>npx tsx scripts/jev-search-index.ts content/docs /docs</code>,
              which splits each page at its headings.
            </p>
          </div>
        </div>
        <div class="step-row">
          <span class="step-num">3</span>
          <div>
            <h3>Render it</h3>
            <Code code={usage} lang="tsx" theme="github-light" />
            <p class="fine">
              <code>⌘K</code> opens it. Plain shadcn tokens, so it inherits your theme; set <code>--jev-accent</code> to
              brand it.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="machine" id="how" aria-labelledby="how-title">
      <div class="section-head">
        <div><p class="eyebrow">how it works</p><h2 id="how-title">The TypeSafe request and answer</h2></div>
        <a class="repo-link" href="https://docs.typesafe.ai/api" target="_blank" rel="noopener">typesafe api ↗</a>
      </div>
      <p class="prose-note">
        Twenty candidates, a yes/no question each and one <code>choice</code> across them, in a single request. Real
        exchange for <code>what do I do when I get a 429</code>, trimmed to three candidates.
      </p>
      <Tabs labels={["Request", "Answer"]} storageKey="wire">
        <div><Code code={wireRequest} lang="json" theme="github-light" /></div>
        <div><Code code={wireAnswer} lang="json" theme="github-light" /></div>
      </Tabs>
      <p class="fine">
        The page that answers, <b>Retries</b>, was tenth on keyword score, below three pages Jev scored at {0.06} and
        under. It took {0.91} of the best-answer probability and moved to first.
      </p>
    </section>

    <details>
      <summary>Limits, costs, and what gets sent</summary>
      <div class="details-grid">
        <p>
          <b>What leaves your server.</b> Each candidate's title, description and first {320} characters, over HTTPS.
          Nothing else, and never your API key.
        </p>
        <p>
          <b>Jev re-ranks, it does not retrieve.</b> A page outside the top twenty cannot win. That ceiling is
          {pct(ceiling.recall)} here, and Jev converts all of it.
        </p>
        <p>
          <b>Cost.</b> {cost.meanInputTokens.toLocaleString()} input tokens per uncached query, about ${perThousand} per
          thousand searches. Output tokens are free.
        </p>
        <p>
          <b>The cache is in memory.</b> A thousand queries per process, no expiry. Serverless will miss it often.
        </p>
      </div>
    </details>

    <footer>
      <span>jev-search · MIT</span>
      <span>
        <a href={repo} target="_blank" rel="noopener">GitHub</a> · <a href="https://typesafe.ai">TypeSafe</a> ·
        <a href="https://jevql.fly.dev" target="_blank" rel="noopener">jevQL</a>
      </span>
    </footer>
  </main>

  <script>
    import "@/scripts/copy-buttons"

    // The install command reflects wherever this site is hosted.
    const cmd = `npx shadcn@latest add ${location.origin}/r/jev-search.json`
    for (const el of document.querySelectorAll<HTMLElement>("[data-registry-line]")) el.textContent = cmd
    for (const el of document.querySelectorAll<HTMLElement>("[data-registry-cmd]")) el.dataset.copy = cmd

    function flash(btn: HTMLElement, ok = true) {
      const original = btn.innerHTML
      btn.innerHTML = `<span class="material-symbols-rounded" aria-hidden="true">${ok ? "check" : "close"}</span>${btn.classList.contains("small") ? "" : " copied"}`
      setTimeout(() => (btn.innerHTML = original), 1200)
    }

    document.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>(".copy")
      if (!btn) return
      const text = btn.hasAttribute("data-copy-from-registry") ? cmd : btn.dataset.copy || ""
      try {
        await navigator.clipboard.writeText(text)
        flash(btn)
      } catch {
        flash(btn, false)
      }
    })
  </script>
</Layout>

<style is:global>
  code {
    font: inherit;
    font-family: ui-monospace, monospace;
    font-weight: 800;
  }
  .lede {
    max-width: 760px;
    line-height: 1.7;
  }
  .lede a {
    color: inherit;
  }
  .hero {
    padding: 38px 0 26px;
  }
  .hero .lede {
    margin: 26px 0 24px;
  }
  .hero-cmd {
    margin: 22px 0;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .brand svg {
    width: 28px;
    height: 28px;
  }
  .mast .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .mast-right {
    gap: 10px;
  }
  .section-head {
    margin-bottom: 16px;
  }
  button.small {
    padding: 8px 9px;
    box-shadow: 2px 2px 0 var(--ink);
  }
  /* tabs, as on jevQL */
  .doc-tabs { margin: 0; }
  .doc-tablist { display: flex; gap: 6px; }
  .doc-tab { padding: 9px 12px; border: 1.5px solid var(--ink); border-bottom: 0; background: #ecebe4; box-shadow: none; font-size: .62rem; }
  .doc-tab[aria-selected="true"] { background: var(--lime); }
  .doc-tabpanels > * { border: 1.5px solid var(--ink); padding: 14px; background: var(--panel); }
  .doc-tabpanels > *[hidden] { display: none; }
  .doc-tabpanels pre, .step-row pre { margin: 0; border: 1px solid var(--line); padding: 12px 14px; overflow-x: auto; font: 600 .74rem/1.55 ui-monospace, monospace; background: #fff !important; }
  .doc-tabpanels .fine { margin: 10px 0 0; }
  .step-row .astro-code { margin-bottom: 10px; }
  /* copy buttons on code blocks */
  .copy-wrap { position: relative; }
  .copy-wrap > pre { margin: 0 0 10px; }
  .copy-btn { position: absolute; top: 6px; right: 6px; display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; padding: 0; border: 1.5px solid var(--ink); background: #fff; box-shadow: 2px 2px 0 var(--ink); opacity: 0; transition: opacity 120ms, background-color 120ms; }
  .copy-wrap:hover .copy-btn, .copy-btn:focus-visible, .copy-btn.done { opacity: 1; }
  .copy-btn:hover { background: #ecebe4; }
  .copy-btn.done { background: var(--lime); }
  .copy-btn:active:not(:disabled) { transform: none; box-shadow: none; }
  details summary { display: flex; align-items: center; gap: 10px; list-style: none; }
  details summary::-webkit-details-marker { display: none; }
  details summary::before { content: "▸"; font-size: .9rem; }
  details[open] summary::before { content: "▾"; }
  details[open] summary { border-bottom: 1px solid var(--line); }
  .details-grid { gap: 18px 32px; padding: 20px; border-top: 0; }
  .details-grid p { margin: 0; }
  @media (max-width: 750px) {
    .mast { flex-direction: row; align-items: center; justify-content: space-between; padding-bottom: 10px; }
    .mast .brand { font-size: 1.25rem; }
    .mast-right { width: auto; flex-direction: row; align-items: center; gap: 8px; }
    .mast .tagline, .mast .repo-link:not(:last-child) { display: none; }
    .details-grid { padding: 16px; gap: 14px; }
    .copy-btn { display: none; }
  }
</style>
